{
  "name": "better-vanillasky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:cache-worker": "npx wrangler dev --config workers/vs-cache/wrangler.jsonc --port 8788",
    "build": "node scripts/generate-seo.mjs --public && tsc -b && vite build && node scripts/generate-seo.mjs --dist",
    "check:live-robots": "node scripts/check-live-robots.mjs",
    "generate:social-preview": "node scripts/generate-social-preview.mjs",
    "generate:search-preview": "node scripts/generate-search-preview.mjs",
    "test": "vitest run",
    "inspect:booking": "node scripts/inspect-booking-flow.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.9"
  }
}
