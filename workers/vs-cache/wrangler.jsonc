{
  "name": "better-vanillasky-cache",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PRELOAD_OFFICIAL_LOCALES": "en",
    "PRELOAD_CONCURRENCY": "4",
    "PUBLIC_APP_ORIGIN": "https://getflights.ge",
    "TELEGRAM_BOT_USERNAME": "get_flights_ge_bot"
  },
  // Telegram alerts use this D1 binding plus two Worker secrets set with
  // `wrangler secret put` (never committed, never in vars):
  //   TELEGRAM_BOT_TOKEN      - Bot API token from @BotFather
  //   TELEGRAM_WEBHOOK_SECRET - the same value passed as setWebhook secret_token
  //
  // The Telegram Login Widget binding is staging-only and is deliberately NOT
  // configured here: with these unset, /api/alerts/telegram/login answers 404.
  // Set them on the staging Worker only (`wrangler deploy --var ...`, or a
  // staging-specific config):
  //   TELEGRAM_LOGIN_ENABLED         - exactly "true" to expose the endpoint
  //   TELEGRAM_LOGIN_ALLOWED_ORIGINS - comma-separated stage origins allowed to
  //                                    call it; an empty list denies everyone
  "d1_databases": [
    {
      "binding": "ALERTS_DB",
      "database_name": "getflights-alerts",
      "database_id": "f9dbc270-554d-4ea6-997c-c4373fef0eb1"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "VS_CACHE_KV",
      "id": "22f50f2f19cc40689835f232a0dbef4c",
      "preview_id": "3b909f6844bd41dd86220b1ac48422ba"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VS_CACHE_COORDINATOR",
        "class_name": "RefreshCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RefreshCoordinator"]
    }
  ]
}
