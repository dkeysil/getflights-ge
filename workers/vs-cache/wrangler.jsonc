{
  "name": "better-vanillasky-cache",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PRELOAD_OFFICIAL_LOCALES": "en",
    "PRELOAD_CONCURRENCY": "4"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "VS_CACHE_KV",
      "id": "22f50f2f19cc40689835f232a0dbef4c",
      "preview_id": "3b909f6844bd41dd86220b1ac48422ba"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VS_CACHE_COORDINATOR",
        "class_name": "RefreshCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RefreshCoordinator"]
    }
  ]
}
